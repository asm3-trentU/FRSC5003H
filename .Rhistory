data <- readRDS("Full_Columned_Database.RDS")
drug_ref <- readRDS("Drug_Reference.RDS")
data <- data[,-1]
data <- data[seq(450),c(drug_ref$Index_Reference)]
class_df <- data.frame(Class = drug_ref$Class)
seq_df <- data.frame(Sequence = seq(141))
seq_a <- data.frame()
seq_f <- data.frame()
seq_c <- data.frame()
r_check <- 0
for (n in class_df$Class){
r_check <- r_check + 1
if (n == "Amphetamine"){
seq_a <- rbind(seq_a, seq_df$Sequence[r_check])
} else if (n == "Fentanyl"){
seq_f <- rbind(seq_f, seq_df$Sequence[r_check])
} else if (n == "Cocaine"){
seq_c <- rbind(seq_c, seq_df$Sequence[r_check])
}
}
colnames(seq_a) <- "Spectra"
colnames(seq_f) <- "Spectra"
colnames(seq_c) <- "Spectra"
total_correct <- 0
total_incorrect <- 0
total_accuracy <- data.frame()
Times_df <- data.frame()
n = 1
sel_amph <- sample.split(seq_a$Spectra, SplitRatio = 9)
sel_fent <- sample.split(seq_f$Spectra, SplitRatio = 9)
selectamph <- subset(seq_a$Spectra, sel_amph == TRUE)
selectfent <- subset(seq_f$Spectra, sel_fent == TRUE)
split_amph <- sample.split(selectamph, SplitRatio = 0.4)
split_fent <- sample.split(selectfent, SplitRatio = 0.4)
split_coc <- sample.split(seq_c$Spectra, SplitRatio = 0.4)
test_amph <- subset(selectamph, split_amph == TRUE)
test_fent <- subset(selectfent, split_fent == TRUE)
test_coc <- subset(seq_c$Spectra, split_coc == TRUE)
train_amph <- subset(selectamph, split_amph == FALSE)
train_fent <- subset(selectfent, split_fent == FALSE)
train_coc <- subset(seq_c$Spectra, split_coc == FALSE)
test_use <- c(test_amph, test_fent, test_coc)
train_use <- c(train_amph, train_fent, train_coc)
correct <- 0
incorrect <- 0
test_use
spec = 23
temp_dat <- data[,c(train_use, spec)]
View(temp_dat)
View(temp_dat)
temp_dat <- data[,c(train_use, spec)]
max_dat <- max(temp_dat)
min_dat <- min(temp_dat)
nor <- (temp_dat - min_dat) / (max_dat - min_dat)
pca_proj <- PCA(nor,
graph = FALSE,
ncp = 5)
proj <- data.frame(pca_proj$ind$coord)
View(proj)
